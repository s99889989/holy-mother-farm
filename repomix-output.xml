<style>
@import url('https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;700;900&family=Noto+Sans+TC:wght@300;400;500;700&display=swap');

:root{
  --g:#1a5c36; --gm:#267a4a; --gl:#95d4ae; --gp:#eaf6ee;
  --r:#8c3010; --rm:#b84015; --rl:#f2a882; --rp:#fdf0ea;
  --p:#302c7a; --pm:#4a46a8; --pl:#b0add8; --pp:#f0eff9;
  --ink:#1c1c1e; --ink2:#3a3a3c; --muted:#6e6e73;
  --border:#e5e5ea; --paper:#f5f5f0; --white:#fff;
}
*{margin:0;padding:0;box-sizing:border-box;}
body{font-family:'Noto Sans TC',sans-serif;background:var(--paper);color:var(--ink);line-height:1.8;}

/* NAV */
.nav{
  position:sticky;top:0;z-index:100;
  background:#1c1c1e;
  display:flex;align-items:stretch;
  border-bottom:1px solid rgba(255,255,255,.06);
}
.nav-brand{
  padding:0 22px;font-family:'Noto Serif TC',serif;
  font-size:13px;font-weight:700;color:#fff;
  letter-spacing:2px;display:flex;align-items:center;
  border-right:1px solid rgba(255,255,255,.08);white-space:nowrap;
}
.nav-tabs{display:flex;overflow-x:auto;}
.tab{
  padding:15px 18px;font-size:12.5px;font-weight:500;
  color:rgba(255,255,255,.4);border:none;background:none;
  border-bottom:3px solid transparent;cursor:pointer;
  white-space:nowrap;transition:all .18s;letter-spacing:.3px;
}
.tab:hover{color:rgba(255,255,255,.75);}
.tab.t-g{color:#86efac;border-bottom-color:#86efac;}
.tab.t-r{color:#fca5a5;border-bottom-color:#fca5a5;}
.tab.t-p{color:#c4b5fd;border-bottom-color:#c4b5fd;}
.tab.t-w{color:#fde68a;border-bottom-color:#fde68a;}

/* SECTION */
.sec{display:none;animation:fadeIn .3s ease;}
.sec.on{display:block;}
@keyframes fadeIn{from{opacity:0;transform:translateY(10px);}to{opacity:1;transform:translateY(0);}}

/* ── HOME ── */
.home-hero{
  min-height:400px;
  background:linear-gradient(160deg,#0d1f15 0%,#1a3d28 40%,#1e1a4a 100%);
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  padding:60px 24px;text-align:center;position:relative;overflow:hidden;
}
.home-hero::before{
  content:'';position:absolute;inset:0;
  background:url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none'%3E%3Cg fill='%23ffffff' fill-opacity='0.025'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
}
.home-eyebrow{
  font-size:11px;letter-spacing:4px;color:rgba(255,255,255,.4);
  margin-bottom:20px;text-transform:uppercase;
}
.home-title{
  font-family:'Noto Serif TC',serif;
  font-size:clamp(28px,5vw,52px);font-weight:900;
  color:#fff;letter-spacing:4px;line-height:1.25;margin-bottom:10px;
}
.home-sub{font-size:14px;color:rgba(255,255,255,.45);margin-bottom:44px;letter-spacing:1px;}
.course-cards{
  display:flex;gap:12px;flex-wrap:wrap;justify-content:center;
}
.cc{
  background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);
  border-radius:18px;padding:22px 26px;min-width:150px;cursor:pointer;
  transition:all .2s;backdrop-filter:blur(6px);text-align:center;
}
.cc:hover{background:rgba(255,255,255,.12);transform:translateY(-3px);}
.cc .cc-icon{font-size:30px;margin-bottom:8px;}
