      position: absolute;
      width: 60px;
      height: 60px;
      top: 10px;
      right: 0px;
      transition-duration: 0.1s;

      .icon{
        transition-duration: 0.1s;
        position: absolute;
        width: 30px;
        height: 3px;
        top: 30px;
        right: 15px;
        background-color: #F8C26A;

        &:before, &:after{
          transition-duration: 0.1s;
          position: absolute;
          width: 30px;
          height: 3px;
          background-color: #F8C26A;
          content: "";
        }

        &:before{
          top: -7px;
          left: 0;
        }

        &:after{
          top: 7px;
          left: 0;
        }
      }

      &:hover{
        cursor: pointer;

        .icon{
          &:before{
            top: -10px;
          }

          &:after{
            top: 10px;
          }
        }
      }

      &.open{
        transition-duration: 0.1s;
        transform: rotate(180deg);
        -webkit-transform: rotate(180deg);

        .icon{
          transition-duration: 0.1s;
          background-color: transparent;

          &:before{
            transition-duration: 0.1s;
            top: 0;
            transform: rotate(45deg);
            -webkit-transform: rotate(45deg);
          }

          &:after{
            transition-duration: 0.1s;
            top: 0;
            transform: rotate(-45deg);
            -webkit-transform: rotate(-45deg);
          }
        }
      }
    }
