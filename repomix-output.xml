.bx-q{background:var(--white);border:1px solid var(--border);}
.bx-q::before{background:#4f46e5;content:'💬 引導問題';}
.bx-a{background:#f0fdf4;border:1px solid #bbf7d0;}
.bx-a::before{background:#15803d;content:'🎯 互動活動';}
.bx-t{background:#fffbeb;border:1px solid #fde68a;}
.bx-t::before{background:#b45309;content:'💡 講師提示';}

/* herb card */
.herb-card{
  display:grid;grid-template-columns:6px 1fr;
  background:var(--white);border:1px solid var(--border);
  border-radius:14px;overflow:hidden;margin-bottom:10px;
}
.hc-bar-g{background:linear-gradient(180deg,var(--g),var(--gm));}
.hc-bar-r{background:linear-gradient(180deg,var(--r),var(--rm));}
.hc-bar-p{background:linear-gradient(180deg,var(--p),var(--pm));}
.hc-body{padding:16px 18px;}
.hc-top{display:flex;align-items:center;gap:11px;margin-bottom:8px;}
.hc-icon{font-size:34px;}
.hc-name{font-size:15px;font-weight:700;margin-bottom:1px;}
.hc-sci{font-size:10px;color:var(--muted);font-style:italic;}
.hc-desc{font-size:12.5px;color:var(--ink2);margin-bottom:9px;line-height:1.7;}

/* garden block */
.garden-block{
  border-radius:14px;overflow:hidden;margin-bottom:10px;
  border:1px solid #bbf7d0;
}
.garden-banner{
  background:linear-gradient(135deg,#052e16 0%,#14532d 60%,#166534 100%);
  padding:14px 18px;
  display:flex;align-items:center;gap:10px;
}
.garden-banner .gb-icon{font-size:22px;}
.garden-banner .gb-title{
  font-size:13px;font-weight:700;color:#fff;letter-spacing:.5px;
}
.garden-banner .gb-sub{font-size:11px;color:rgba(255,255,255,.55);margin-top:1px;}
.garden-banner .gb-badge{
  margin-left:auto;background:rgba(255,255,255,.15);
  border:1px solid rgba(255,255,255,.25);border-radius:8px;
  padding:3px 10px;font-size:10px;font-weight:700;
  color:rgba(255,255,255,.8);white-space:nowrap;
}
.garden-body{background:#f0fdf4;padding:16px 18px;}
.garden-body .garden-intro{
  font-size:13px;color:#166534;font-weight:600;margin-bottom:12px;
}
.herb-grid{
  display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));
  gap:8px;margin-bottom:12px;
}
.herb-tile{
  background:var(--white);border:1px solid #bbf7d0;
  border-radius:10px;padding:10px 11px;
}
.herb-tile .ht-icon{font-size:20px;margin-bottom:4px;}
.herb-tile .ht-name{font-size:12px;font-weight:700;margin-bottom:2px;}
.herb-tile .ht-name.star{color:var(--gm);}
.herb-tile .ht-name.star-r{color:var(--rm);}
.herb-tile .ht-name.star-p{color:var(--pm);}
.herb-tile .ht-tag{font-size:10px;color:var(--muted);line-height:1.5;}
.herb-tile .ht-badge{
  display:inline-block;font-size:9px;font-weight:700;
  padding:1px 6px;border-radius:4px;margin-bottom:4px;
}
.hb-main{background:#dcfce7;color:#166534;}
.hb-sup{background:#f3f4f6;color:#6b7280;}
.garden-tasks{display:flex;flex-direction:column;gap:7px;}
.garden-task{
  display:flex;align-items:flex-start;gap:8px;
  font-size:12.5px;color:var(--ink2);line-height:1.6;
}
.gt-num{
  width:20px;height:20px;border-radius:50%;
  background:var(--gm);color:#fff;
  font-size:10px;font-weight:700;
  display:flex;align-items:center;justify-content:center;
  flex-shrink:0;margin-top:2px;
}
.gt-num-r{background:var(--rm);}
.gt-num-p{background:var(--pm);}
.garden-tip{
  background:rgba(21,128,61,.08);border-left:3px solid var(--gm);
  border-radius:0 8px 8px 0;padding:8px 12px;
  font-size:11.5px;color:#166534;margin-top:10px;line-height:1.65;
}

/* formula section */
.formula-wrap{margin-bottom:10px;}
.formula-title{
  font-size:11px;font-weight:700;letter-spacing:1px;
  color:var(--muted);margin-bottom:10px;text-transform:uppercase;
}
.tea-cards{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
@media(max-width:460px){.tea-cards{grid-template-columns:1fr;}}
.tea-card{
  background:var(--white);border:1px solid var(--border);
  border-radius:12px;padding:15px;
}
.tea-tag{
  font-size:10px;font-weight:700;padding:2px 8px;
