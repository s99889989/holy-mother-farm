}
.tt-g{background:var(--gp);color:var(--g);}
.tt-r{background:var(--rp);color:var(--r);}
.tt-p{background:var(--pp);color:var(--p);}
.tea-card h4{font-size:13.5px;font-weight:700;margin-bottom:6px;}
.tea-card .ingredients{margin-bottom:8px;}
.ingredient-row{
  display:flex;align-items:flex-start;gap:7px;
  font-size:12px;color:var(--ink2);line-height:1.6;margin-bottom:3px;
}
.ing-dot{
  width:6px;height:6px;border-radius:50%;
  margin-top:6px;flex-shrink:0;
}
.ing-main-g{background:var(--gm);}
.ing-main-r{background:var(--rm);}
.ing-main-p{background:var(--pm);}
