  <div class="herb-overview">
    <div style="font-family:'Noto Serif TC',serif;font-size:19px;font-weight:700;margin-bottom:20px;padding-bottom:12px;border-bottom:2px solid var(--border);">🌿 三套課程主角藥草一覽</div>
    <div class="ov-grid">
      <div class="ov-card ov-g">
