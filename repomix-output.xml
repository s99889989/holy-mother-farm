/* ── COURSE LAYOUT ── */
.c-banner{padding:52px 28px 40px;position:relative;overflow:hidden;}
.c-banner.bg-g{background:linear-gradient(145deg,#0b2e1a 0%,#1a5c36 55%,#267a4a 100%);}
.c-banner.bg-r{background:linear-gradient(145deg,#3d1206 0%,#8c3010 55%,#b84015 100%);}
