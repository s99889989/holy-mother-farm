}
.cc .cc-lbl{font-size:11px;letter-spacing:1px;opacity:.5;}
.cc-g .cc-kanji{color:#86efac;}
.cc-r .cc-kanji{color:#fca5a5;}
.cc-p .cc-kanji{color:#c4b5fd;}
.cc-g .cc-kanji2{color:#86efac;}
.cc-r .cc-kanji2{color:#fca5a5;}
.cc-p .cc-kanji2{color:#c4b5fd;}

.herb-overview{max-width:860px;margin:0 auto;padding:44px 24px;}
.ov-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:32px;}
