<script>
function go(id, btn) {
  document.querySelectorAll('.sec').forEach(s=>s.classList.remove('on'));
  document.querySelectorAll('.tab').forEach(b=>b.classList.remove('t-g','t-r','t-p','t-w'));
  document.getElementById('sec-'+id).classList.add('on');
  if(btn){
    const m={home:'t-w',g:'t-g',r:'t-r',p:'t-p',ws:'t-w'};
    btn.classList.add(m[id]||'t-w');
  }
  window.scrollTo({top:0,behavior:'smooth'});
}
function pick(el, theme){
  const cls = 'c'+theme;
  el.classList.toggle(cls);
}
function star(n){
  document.querySelectorAll('#ws-stars span').forEach((s,i)=>{
    s.textContent = i<n?'⭐':'☆';
  });
}
document.querySelector('.tab').click();
</script>
