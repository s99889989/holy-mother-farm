  font-size:14px;font-weight:800;color:#fff;flex-shrink:0;
}
.n-g{background:var(--gm);}
.n-r{background:var(--rm);}
.n-p{background:var(--pm);}
.ph-title{font-size:16px;font-weight:700;}
.ph-time{
  font-size:10px;font-weight:700;padding:3px 10px;
  border-radius:8px;white-space:nowrap;
}
.pt-g{background:var(--gp);color:var(--g);}
.pt-r{background:var(--rp);color:var(--r);}
.pt-p{background:var(--pp);color:var(--p);}
.ph-body{padding-left:48px;}
@media(max-width:480px){.ph-body{padding-left:0;}}

/* boxes */
.box{
  border-radius:11px;padding:15px 18px;margin-bottom:10px;
  position:relative;
}
.box::before{
  content:attr(data-t);position:absolute;top:-9px;left:12px;
  font-size:10px;font-weight:700;padding:1px 9px;
  border-radius:7px;color:#fff;letter-spacing:.3px;
}
.box p,.box li{font-size:13.5px;line-height:1.95;color:var(--ink2);}
.box ul{padding-left:15px;}
.bx-s{background:var(--white);border:1px solid var(--border);}
