.formula-logic-r{border-left-color:var(--rl);}
.formula-logic-p{border-left-color:var(--pl);}

/* concept grid */
.concept-row{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:10px;}
