.c-body{max-width:820px;margin:0 auto;padding:36px 24px 56px;}

/* timebar */
.tbar-wrap{margin-bottom:28px;}
.tbar-label{font-size:10px;color:var(--muted);letter-spacing:1px;margin-bottom:6px;}
.tbar{display:flex;height:10px;border-radius:8px;overflow:hidden;gap:2px;}
.tb{height:100%;}
.tbar-legend{display:flex;flex-wrap:wrap;gap:8px;margin-top:8px;}
.tl{display:flex;align-items:center;gap:4px;font-size:10px;color:var(--muted);}
.tl-dot{width:8px;height:8px;border-radius:2px;flex-shrink:0;}

/* phase */
.phase{margin-bottom:30px;}
.ph-hd{display:grid;grid-template-columns:38px 1fr auto;align-items:center;gap:10px;margin-bottom:14px;}
.ph-num{
  width:38px;height:38px;border-radius:50%;
