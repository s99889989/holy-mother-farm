        </div>
        <div style="font-size:11px;color:var(--muted);margin-top:6px;">鳳梨鼠尾草的果香柔化魚腥草的氣味，淨化＋美顏雙效</div>
      </div>
      <!-- 幸福茶 -->
      <div style="background:var(--white);border:1px solid var(--border);border-radius:12px;padding:16px;border-left:4px solid var(--gm);">
